# Copy to .env and fill in. Boot validation (src/config/env.js) refuses to start the
# server if any of these is missing, malformed, or (for secrets) looks like a placeholder.

# development | test | production
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Atlas dashboard → Database → Connect → Drivers.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=nailsbymandisa

# Generate with: openssl rand -hex 32 (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Must be a real random value — boot validation rejects short/dictionary-word secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of frontend origins allowed to call this API.
# Must NOT include localhost in production.
CORS_ORIGINS=http://localhost:5173
# Base URL of the customer-facing site, used to build links in transactional emails.
CLIENT_URL=http://localhost:5173

# Yoco dashboard → Settings → API Keys.
YOCO_SECRET_KEY=
# Yoco dashboard → Settings → Webhooks → the signing secret for the endpoint you register
# pointing at POST /api/payments/webhook. Looks like "whsec_XXXXXXXX...". Required —
# webhook processing fails closed without it (see §4.4).
YOCO_WEBHOOK_SECRET=

# Transactional email (booking confirmations, password reset, status updates).
# Any SMTP provider works (e.g. Gmail app password, Postmark, SES SMTP credentials).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NailsByMandisa <nailsbymandisa@gmail.com>"

# Sentry project → Settings → Client Keys (DSN). Required in production.
SENTRY_DSN=

# Optional — SMS/WhatsApp notifications via Twilio. Leave blank to disable that channel.
# Twilio console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — browser push for admin new-booking alerts. Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional — real image uploads for the gallery (admin posts + client submissions).
# Cloudinary dashboard → free tier is enough. Without these, POST /api/uploads/image
# returns a clear 503 rather than pretending to succeed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
